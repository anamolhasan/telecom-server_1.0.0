// Agent is NOT a role. An approved agent keeps Role.USER and is granted the
// agent feature set through AppUser.canEarn + AgentApplication.status instead.
enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORTER
  EMPLOYEE
  USER
}

enum UserStatus {
  ACTIVE
  SLEEPING
  INACTIVE
  PENDING
  SUSPENDED
  BLOCKED
  VERIFIED
  DELETED
}

enum Gender {
  MALE
  FEMALE
}

enum OrderStatus {
  PENDING
  PROCESSING
  WORKING
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// Legacy product classification retained on OperatorOffer (see `type`). Kept for
// backward compatibility with existing rows, orders and the operator-offer `type`
// filter; new authoring uses the richer OperatorOfferType below.
enum ProductType {
  RECHARGE
  BUNDLE
  MINUTE
  INTERNET
  OTHER
}

// Offers associated with telecom operators. Global Offers will be a separate,
// later feature and deliberately do not reuse these names.
