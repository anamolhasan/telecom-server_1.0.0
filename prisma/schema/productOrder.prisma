// E-commerce order header.
//
// Deliberately separate from the Telecom `Order` model (telecom.prisma), which
// keeps its own lifecycle, single-offer shape and Float money fields. Nothing in
// the Telecom/Payment/Wallet models is renamed or reshaped by this file.
//
// 💰 All amounts are Decimal(12, 2) (see productVariant.prisma for the rationale).
// `currency` mirrors Payment.currency in telecom.prisma: an unconstrained String
// with a lowercase ISO default of "bdt".
//
// 📦 Shipping data is an immutable snapshot captured at checkout. It is stored as
// flat columns (not a live FK to ShippingAddress) so editing or deleting the
// customer's saved address can never rewrite history, and so admins can filter
// orders by division/district. `shippingRecipientName` and `shippingPhone` are
// the "recipient" and "contact phone" pair; `customerNote` is the buyer's note.
model ProductOrder {
  id String @id @default(uuid(7))

  // Human-readable identifier generated by the application layer
  // (e.g. RZQ-20261017-0001). Unique index doubles as the lookup path.
  orderNumber String @unique @db.VarChar(32)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status ProductOrderStatus @default(PENDING)

  // 💵 Payment (Phase 2A: Cash on Delivery only).
  //
  // Collection state is tracked separately from `status`: fulfilment reaching
  // DELIVERED never implies the cash was collected, and the money is marked
  // PAID only when staff record the actual collection (`paidAt`).
  //
  // This is order-local e-commerce payment state. No Telecom `Order` and no
  // Telecom `Payment` row is created for an e-commerce order.
  paymentMethod ProductPaymentMethod @default(COD)
  paymentStatus ProductPaymentStatus @default(UNPAID)
  paidAt        DateTime?

  // 🔁 Idempotency.
  //
  // The client sends one key per checkout attempt. `(userId, idempotencyKey)`
  // is unique at the database level, so a double-click, retry or network
  // failure resolves to the original order instead of ordering (and deducting
  // stock) twice. Nullable because orders created outside the checkout API
  // (support/admin tooling) do not consume a key; PostgreSQL treats NULLs as
  // distinct, so any number of key-less orders may coexist.
  idempotencyKey String? @db.VarChar(100)

  // 💰 Totals. grandTotal = subtotal - discountAmount + shippingAmount.
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  shippingAmount Decimal @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal @default(0) @db.Decimal(12, 2)
  currency       String  @default("bdt")

  // 📦 Delivery snapshot (Bangladesh-oriented; finer levels optional).
  shippingRecipientName String  @db.VarChar(150)
  shippingPhone         String  @db.VarChar(30)
  shippingDivision      String  @db.VarChar(100)
  shippingDistrict      String  @db.VarChar(100)
  shippingUpazila       String? @db.VarChar(100)
  shippingUnionArea     String? @db.VarChar(100)
  shippingVillageRoad   String? @db.VarChar(255)
  shippingPostalCode    String? @db.VarChar(10)

  customerNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ProductOrderItem[]
  shipments Shipment[]

  // 💵 Earning foundation back-relations (see earning.prisma)
  earnings             EarningTransaction[]  @relation("EarningProductOrder")
  affiliateConversions AffiliateConversion[] @relation("AffiliateConversionOrder")

  // Composite indexes cover the two common access patterns: a buyer's order
  // history (userId + newest first) and the admin queue by status.
  @@unique([userId, idempotencyKey], name: "uniq_product_order_user_idempotency_key")
  @@index([userId, createdAt], name: "idx_product_order_userId_createdAt")
  @@index([status, createdAt], name: "idx_product_order_status_createdAt")
  @@map("product_orders")
}

// A single purchased line, frozen at purchase time.
//
// Historical integrity: `productName`, `variantName`, `sku` and `unitPrice` are
// snapshots taken when the order is placed — renaming, repricing, archiving or
// deleting a catalog product/variant must never mutate past orders. The catalog
// links are therefore nullable with onDelete: SetNull (a required Cascade would
// delete order history along with a deleted variant). No polymorphic order
// relation is involved: this table belongs to ProductOrder alone.
model ProductOrderItem {
  id             String       @id @default(uuid(7))
  productOrderId String
  productOrder   ProductOrder @relation(fields: [productOrderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Kept so sales reporting still resolves a product after its variant row is
  // gone.
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  // 🧾 Purchase-time snapshot
  productName String  @db.VarChar(200)
  variantName String? @db.VarChar(200)
  sku         String  @db.VarChar(100)
  unitPrice   Decimal @db.Decimal(12, 2)

  quantity  Int     @default(1)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productOrderId], name: "idx_product_order_item_productOrderId")
  @@index([variantId], name: "idx_product_order_item_variantId")
  @@index([productId], name: "idx_product_order_item_productId")
  @@map("product_order_items")
}
